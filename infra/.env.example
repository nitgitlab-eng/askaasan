# Compose settings for infra/docker-compose.yml. Copy to infra/.env (gitignored) and fill in.
# App settings (API keys, DJANGO_SECRET_KEY, ...) live in api/.env: run `uv run python manage.py setup_env` in api/.

# Required. Long random values, URL-safe (they go inside DATABASE_URL / REDIS_URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Public address of the site (nginx). Defaults suit http://localhost:8080.
# Passkeys need WEBAUTHN_RP_ID to be the bare host name of FRONTEND_URL (open the site at localhost, not 127.0.0.1).
FRONTEND_URL=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=
DJANGO_ALLOWED_HOSTS=

# Host port for nginx (default 8080).
WEB_PORT=
# Required. Image tag for aasan-api / aasan-web; every compose command refuses to run without it.
#   Production / staging: the release tag CI built and pushed (e.g. TAG=v1.3.0), with AASAN_IMAGE_PREFIX set below.
#   Roll back by setting the previous tag and running `pull` + `up -d --no-build` again.
#   Local build on this machine: TAG=dev and `up --build`.
TAG=
# Registry and name prefix for the images: <prefix>-api and <prefix>-web. Default `aasan` (local images only).
# Images published by .github/workflows/release-images.yml: AASAN_IMAGE_PREFIX=ghcr.io/<github-owner, lowercase>/aasan
AASAN_IMAGE_PREFIX=
# Proxies in front of Django: 1 = this nginx only (default), 2 = a cloud load balancer + nginx.
DJANGO_NUM_PROXIES=
# true once HTTPS terminates in front of nginx.
DJANGO_SECURE_SSL_REDIRECT=

# ── Mail ─────────────────────────────────────────────────────────────────
# Default: every email lands in the local mailpit inbox (http://localhost:8025). For real mail set the SMTP server:
# EMAIL_HOST=smtp.example.com  EMAIL_PORT=587  EMAIL_USE_TLS=true  EMAIL_HOST_USER=...  EMAIL_HOST_PASSWORD=...
# (Admin console → Email (SMTP) overrides these once configured.)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
DEFAULT_FROM_EMAIL=
# Host ports for mailpit, bound to 127.0.0.1 only (defaults 8025 UI, 1025 SMTP).
MAILPIT_UI_PORT=
MAILPIT_SMTP_PORT=

# ── Web push ─────────────────────────────────────────────────────────────
# The VAPID key pair lives in api/.env (WEBPUSH_VAPID_PUBLIC_KEY / WEBPUSH_VAPID_PRIVATE_KEY, generated by
# `manage.py setup_env`); the containers read it through env_file. Set the contact address here or there:
# WEBPUSH_VAPID_SUBJECT=mailto:support@<domain>
# Push needs HTTPS in production (browsers allow it on http://localhost only) and outbound HTTPS from the worker to
# the browsers' push services (fcm.googleapis.com, updates.push.services.mozilla.com, *.notify.windows.com,
# web.push.apple.com).

# ── Scaling knobs (see docs/DEPLOY.md) ──────────────────────────────────
# API processes (gunicorn + uvicorn). Empty or 0 = min(2 x CPU + 1, 9).
WEB_CONCURRENCY=
# Postgres pool per API process (defaults 2 / 10). Budget: WEB_CONCURRENCY x DB_POOL_MAX + CELERY_CONCURRENCY x
# WORKER_DB_POOL_MAX + 10 must stay below PG_MAX_CONNECTIONS.
DB_POOL_MIN=
DB_POOL_MAX=
# Per-statement cap in ms for API requests (default 30000) and Celery tasks (default 120000).
DB_STATEMENT_TIMEOUT_MS=
WORKER_DB_STATEMENT_TIMEOUT_MS=
# Celery worker children (default 4) and each child's pool (default 3).
CELERY_CONCURRENCY=
WORKER_DB_POOL_MAX=
# Postgres server (defaults 300 / 1GB / 4GB; a dedicated 16 GB DB server: 4GB / 12GB).
PG_MAX_CONNECTIONS=
PG_SHARED_BUFFERS=
PG_EFFECTIVE_CACHE_SIZE=
# Redis memory caps: broker + channels (noeviction, default 512mb) and the cache (allkeys-lru, default 256mb).
REDIS_MAXMEMORY=
REDIS_CACHE_MAXMEMORY=
# Log level for every app container (default INFO).
LOG_LEVEL=
# Fallback API server if gunicorn misbehaves: API_COMMAND=daphne -b 0.0.0.0 -p 8000 config.asgi:application
API_COMMAND=

# Live voice (self-hosted LiveKit + Sarvam, like ChatGPT voice). Needs a Sarvam key (Admin → Providers) and:
#   docker compose -f infra/docker-compose.yml --profile voice up -d
# Locally nothing else: LiveKit's dev pair (devkey / secret) is the default. Production: set your own pair
# (key: any name, secret: `openssl rand -hex 32`). Without `--profile voice`, voice stays browser/Deepgram.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# What browsers connect to for signalling (through nginx), and the IP they reach for media (UDP 7882 / TCP 7881).
# Production: LIVEKIT_PUBLIC_URL=wss://your.domain/livekit and LIVEKIT_NODE_IP=<public IP> (or LIVEKIT_USE_EXTERNAL_IP=true).
LIVEKIT_PUBLIC_URL=
LIVEKIT_NODE_IP=
LIVEKIT_USE_EXTERNAL_IP=
# Media ports (defaults 7881 TCP, 7882 UDP); change them if another LiveKit on the host already uses them.
LIVEKIT_TCP_PORT=
LIVEKIT_UDP_PORT=

# ── Tuning knobs (all optional; the defaults suit one 8 vCPU / 16 GB host) ──────────────────────────────
# WebSocket channel layer: its own Redis URL (defaults to REDIS_URL, DB 2 in compose), queue capacity per channel,
# seconds an undelivered message lives, seconds a socket keeps its group membership, and the Redis read timeout
# (must exceed the layer's 5 s blocking wait; the default is 30).
# CHANNELS_REDIS_URL=
# CHANNELS_CAPACITY=1000
# CHANNELS_EXPIRY=60
# CHANNELS_GROUP_EXPIRY=86400
# CHANNELS_SOCKET_TIMEOUT=30
# Celery: soft and hard per-task time limits in seconds, and tasks per child before the worker recycles it.
# CELERY_SOFT_TIME_LIMIT=900
# CELERY_TIME_LIMIT=960
# CELERY_MAX_TASKS_PER_CHILD=200
# Postgres pool: seconds to wait for a free pooled connection, and the TCP connect timeout.
# DB_POOL_TIMEOUT=10
# DB_CONNECT_TIMEOUT=5
# SMTP send timeout and the per-check timeout of /api/health/ready/, both in seconds.
# EMAIL_TIMEOUT=20
# HEALTH_TIMEOUT=2

# ── Backups (infra/backup.sh, infra/restore.sh; docs/DEPLOY.md section 7) ─────────────────────────────────
# backup.sh reads these BACKUP_* lines from this file (the environment wins). By default it refuses to run unless
# both BACKUP_AGE_RECIPIENT and BACKUP_COPY_CMD are set: production backups are encrypted and copied off the server.
# age public key (age1..., from `age-keygen` run on your laptop) or a path to a recipients file. The PRIVATE key
# stays off this server (password manager + offline copy), never next to the backups or in api/.env.
BACKUP_AGE_RECIPIENT=
# Copies ./backups off the server after each run; a failure fails the backup. Use copy, not sync, into an
# object-locked bucket, e.g.  rclone copy --immutable ./backups r2:aasan-backups/nightly
#                      or     rsync -a ./backups/ backup@vault.example.com:aasan/
BACKUP_COPY_CMD=
# 1 (default) = require the two settings above. BACKUP_ALLOW_LOCAL=1 is for dev machines only: local, unencrypted
# if no recipient is set, with a warning on every run.
# BACKUP_REQUIRE_OFFSITE=1
# BACKUP_ALLOW_LOCAL=0
# Local folder and how many days to keep there (the off-server copy keeps its own history).
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# restore.sh only: BACKUP_AGE_IDENTITY=/path/to/aasan-backup.key — set it in the shell for the restore, not here.

# ── Point-in-time recovery (optional overlay infra/docker-compose.pitr.yml; DEPLOY.md section 7.3) ─────────
# WAL-G ships WAL every <=5 min and a daily base backup to S3-compatible storage (RPO about 5 min). Use a separate
# bucket from the nightly dumps and a key limited to it. Not needed with managed Postgres that has PITR.
# WALG_S3_PREFIX=s3://aasan-wal/prod
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto                                  # R2: auto; AWS: e.g. ap-south-1
# AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # empty for AWS S3
# AWS_S3_FORCE_PATH_STYLE=                         # true for MinIO
# WALG_PGP_KEY_PATH=/etc/walg/pgp.pub              # client-side encryption: put the public key in infra/walg-keys/
# WALG_RETAIN_FULL=7                               # daily base backups kept
