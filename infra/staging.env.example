# Compose settings for the staging stack (infra/docker-compose.yml + infra/docker-compose.staging.yml).
# Copy to infra/staging.env (gitignored) and pass it with `--env-file infra/staging.env`. It replaces infra/.env for
# staging, so nothing here is shared with production. Any infra/.env.example key can be set here too.

# Required. Different from production's.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Required. The release under test, pulled from the registry (the same TAG is promoted to production afterwards).
TAG=
# ghcr.io/<github owner, lowercase>/aasan
AASAN_IMAGE_PREFIX=

# Public address of staging, e.g. https://staging.askaasan.com (its own host name and passkey RP ID).
FRONTEND_URL=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=
DJANGO_ALLOWED_HOSTS=
DJANGO_SECURE_SSL_REDIRECT=true
# Host port for staging nginx (default 8090; production uses 8080). Mailpit: 8026 / 1026 on 127.0.0.1.
WEB_PORT=

# Razorpay TEST keys only (rzp_test_...). Empty = billing off on staging.
STAGING_RAZORPAY_KEY_ID=
STAGING_RAZORPAY_KEY_SECRET=
STAGING_RAZORPAY_WEBHOOK_SECRET=

# App settings file for staging (default ../api/.env.staging, relative to infra/). Its own secret keys.
STAGING_API_ENV_FILE=

# Small memory profile (production defaults in brackets).
PG_MAX_CONNECTIONS=60
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=512MB
REDIS_MAXMEMORY=128mb
REDIS_CACHE_MAXMEMORY=64mb
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
DB_POOL_MAX=4
