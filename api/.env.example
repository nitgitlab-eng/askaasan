# ── Aasan API configuration ─────────────────────────────────────────────
# Run `uv run python manage.py setup_env` to create .env from this file: it generates DJANGO_SECRET_KEY and
# AASAN_SECRETS_KEY for you. (A plain copy leaves them empty, and the API refuses to start with DEBUG off.)
# Never commit .env — it is gitignored. An empty value (`KEY=`) means "use the default".

# Django
DJANGO_SECRET_KEY=
# Encrypts provider API keys saved in the admin console (setup_env generates one). Required: there is no fallback.
# Use a long random value (50+ characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
AASAN_SECRETS_KEY=
# Rotating AASAN_SECRETS_KEY: put the new value above and the previous one here (comma-separate several).
# Saved keys made with an old value keep working; remove it once every key has been re-saved.
AASAN_SECRETS_KEY_OLD=
DJANGO_DEBUG=true
# Where the web app runs: Vite dev server (:5173) locally. docker-compose sets http://localhost:8080 itself.
FRONTEND_URL=http://localhost:5173
# Comma-separated host names Django answers to (default: localhost,127.0.0.1)
DJANGO_ALLOWED_HOSTS=
# Staff alert emails (comma-separated), e.g. a subscription charged with the wrong amount
DJANGO_ADMINS=

# Optional infra (defaults: SQLite + in-memory channels, Celery tasks run inline, per-process cache)
DATABASE_URL=
REDIS_URL=
# Cache for rate limits (default: REDIS_URL). In production with more than one process this MUST be Redis, or every
# process keeps its own counters. Use a separate Redis DB, e.g. redis://redis:6379/1. It may evict (allkeys-lru).
CACHE_REDIS_URL=
# Security counters: login / admin-login / delete-account lockouts, OTP tries, mail caps, code-guessing budgets.
# Must be a Redis that never evicts and persists (default: REDIS_URL's server, DB 3), so memory pressure or a cache
# restart can't reset a lockout.
SECURITY_REDIS_URL=
# Any setting can be read from a file instead: NAME_FILE=/run/secrets/name (Docker secrets, or a secret manager's
# mounted file), e.g. AASAN_SECRETS_KEY_FILE, DJANGO_SECRET_KEY_FILE, LIVEKIT_API_SECRET_FILE, EMAIL_HOST_PASSWORD_FILE.
# Uploaded lesson images and lecture media (default: api/media)
MEDIA_ROOT=
# Logs: level (default INFO), format json | plain (default plain with DEBUG on, json with it off), and the threshold
# in ms above which a request is logged as slow (default 1000).
LOG_LEVEL=
LOG_FORMAT=
SLOW_REQUEST_MS=

# ── AI providers (fill the ones you use) ────────────────────────────────
# Anthropic — default for tutor (claude-sonnet-5-5) and grading (claude-haiku-5-5)
ANTHROPIC_API_KEY=
# OpenAI — optional, route tasks with LLM_ROUTE_<TASK>=openai:<model>
OPENAI_API_KEY=
# Google Gemini — optional, route with LLM_ROUTE_<TASK>=gemini:<model>
GEMINI_API_KEY=
# Voice providers (optional; usually set in the admin console instead)
SARVAM_API_KEY=
# Deepgram: fast speech-to-text (Nova-3, Indian English + Tamil) and English voices (Aura-2). Admin → Providers.
DEEPGRAM_API_KEY=
GOOGLE_CLOUD_API_KEY=

# Razorpay (fallback only; set keys in Admin console → Payments & plans).
# Test keys start with rzp_test_. Live keys are refused until 'Allow live payments' is on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Per-task routing overrides (leave empty to use defaults)
LLM_ROUTE_TUTOR=
LLM_ROUTE_AUTHOR=
LLM_ROUTE_GRADE=
LLM_ROUTE_SUGGEST=
LLM_ROUTE_ONBOARDING=
LLM_ROUTE_ORG_ASK=

# Offline demo mode: set to "fake" to use a canned tutor with no API calls
LLM_FORCE_PROVIDER=
# Failover: providers to try, in order, when the configured one is rate-limited or down before any text
# (e.g. gemini,openai; their keys come from the admin console or *_API_KEY). Empty = no failover.
LLM_FALLBACK=
# Seconds a failing provider is skipped before it is tried again (default 60)
LLM_BREAKER_SECONDS=
# Monthly AI budget in rupees: staff (DJANGO_ADMINS) get an email at 50%, 80% and 95% of it. 0 = no alerts.
LLM_MONTHLY_BUDGET=
# Load tests only: make the fake provider as slow as a real model, in ms (time to first token, then per chunk).
LLM_FAKE_DELAY_MS=
LLM_FAKE_TOKEN_MS=
# Speech-to-text is charged by clip size, at this many bytes per second. Default 4000 (32 kbps, a browser's usual rate)
# charges normal clips their real length; 750 (6 kbps) stops low-bitrate clips carrying extra audio but over-charges ~5x
STT_CHARGE_BYTES_PER_SEC=
# Live conversation in Ask Aasan streams the mic to Deepgram (Listening = Deepgram + key). One stream is closed after
# this many minutes (default 30); the learner's app reconnects. Charged from the real audio length (16 kHz PCM).
VOICE_STREAM_MAX_MINUTES=

# Live web search: Aasan looks up current facts (prices, news, scores, exam dates) in every AI conversation a learner
# can speak to: mentor chat, Ask Aasan voice, Lesson Ask, Live Class, role-play (the character stays in the scene) and
# workshops (learner turns only; the host never looks up exercise answers), with the configured tutor model's own
# search tool (Anthropic, OpenAI or Gemini). Learn with Kili doesn't search. Each learner gets
# MENTOR_WEB_SEARCH_PER_DAY searching replies a day (default 30); after that Aasan says it can't check live data.
# Blocked domains never appear in results (comma-separated; replaces the built-in adult/betting/piracy list).
# check_guardrails runs the safety red-team set.
MENTOR_WEB_SEARCH=true
MENTOR_WEB_SEARCH_PER_DAY=
WEB_SEARCH_BLOCKED_DOMAINS=

# Live voice (LiveKit, like ChatGPT voice): audio flows over WebRTC between the browser and Aasan's voice agent
# (`manage.py run_voice_agent`), which listens with Sarvam (streaming, Tamil and English), detects the end of each turn,
# speaks with Sarvam and stops the moment the learner talks. The Sarvam key comes from Admin → Providers (Speaking or
# Listening = Sarvam) or SARVAM_API_KEY. Unset: every screen keeps the browser/Deepgram voice.
# Local: `brew install livekit && livekit-server --dev`, then only LIVEKIT_URL=ws://localhost:7880 (the dev key pair
# devkey / secret is the default when the key and secret are left empty). Production sets its own pair: with DEBUG off
# and a public LIVEKIT_PUBLIC_URL the API and agent refuse to start on the dev pair or a secret under 32 characters.
# LIVEKIT_URL is for the API and the agent; LIVEKIT_PUBLIC_URL is the browser's (wss://… in production).
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The agent name the API dispatches to (default aasan-voice).
LIVEKIT_AGENT_NAME=
# A live voice call ends after this many minutes (default 30); one call per learner at a time.
VOICE_LIVE_MAX_MINUTES=
# Live voice calls this host takes at once (default 12; each holds 200-400 MB in the voice agent). Over it, voice
# falls back to streamed listening. 0 = no cap.
VOICE_LIVE_MAX_CALLS=

# ── Data retention (days; 0 keeps forever). Shown on the privacy page; nightly job apps/legal/tasks.py ──
MENTOR_RETENTION_DAYS=365
ROLEPLAY_RETENTION_DAYS=365
LLM_USAGE_RETENTION_DAYS=400
SPEECH_CLIP_RETENTION_DAYS=180

# ── Sign-in ─────────────────────────────────────────────────────────────
# Google sign-in: an OAuth "Web application" client ID from Google Cloud Console → Credentials, with the site URL as an
# authorised JavaScript origin. Public by design (the page reads it from /api/users/auth-config/). Empty = no button.
GOOGLE_CLIENT_ID=
# Organisation SSO (Google Workspace / Microsoft Entra ID) has no setting here: each organisation enters its own client
# ID and secret in its cockpit. Its redirect URI is always FRONTEND_URL + /sso/callback (see docs/DEPLOY.md).
# Passkeys: RP ID is the bare host of the site. Open the app at http://localhost:5173 (not 127.0.0.1) or passkeys fail.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ── Web push notifications ──────────────────────────────────────────────
# VAPID key pair (base64url: raw 32-byte private key, uncompressed public point). `manage.py setup_env` generates a
# pair when neither is set. Keep the private key secret; changing the pair ends every existing subscription. Without
# both keys push is off and the app hides the "Turn on notifications" card.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
# Contact the browser push services can reach you at (mailto: or https:). Default mailto:support@aasan.local.
WEBPUSH_VAPID_SUBJECT=
# Master switch (default true; push still needs both keys).
WEBPUSH_ENABLED=
# Comma-separated push-service hosts a subscription endpoint may use ("*." = any subdomain). Default: Chrome/Edge
# (fcm.googleapis.com, *.notify.windows.com), Firefox (updates.push.services.mozilla.com), Safari (web.push.apple.com,
# *.push.apple.com). Anything else is refused, so a crafted endpoint can't make the server call another address.
WEBPUSH_ENDPOINT_HOSTS=

# ── Calendar sync (fallback only; usually set in Admin console → Integrations) ──
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# ── Learning ────────────────────────────────────────────────────────────
# Minimum score (0..1) on every lesson before a course certificate is issued (default 0.6)
CERT_PASS_SCORE=
# Role-play: AI replies per learner per day (default 150) and XP-earning role-plays per learner per day (default 5)
ROLEPLAY_AI_DAILY=
ROLEPLAY_REWARDS_PER_DAY=
# Guest links: percent (0-100) of the platform's daily guest-AI pool usable by free owners' links (default 80) and
# by unverified owners' links (default 20), so throwaway accounts can't use up what paying creators' guests rely on
GUEST_AI_FREE_SHARE=
GUEST_AI_NEW_SHARE=
# Percent of that pool one free owner's links may use between them per day (default 2); paid owners aren't capped by it
GUEST_AI_FREE_OWNER_SHARE=

# ── AI Workshops ────────────────────────────────────────────────────────
# AI budget units per learner session (default 400), Help requests per learner per hour (default 20), and the daily
# safety cap as a multiple of the planned duration after which only AI turns pause (default 3)
WORKSHOP_SESSION_AI_UNITS=
WORKSHOP_HELP_PER_HOUR=
WORKSHOP_CAP_MULTIPLIER=
# Agent builder: test messages per session (default 40), whether learners may connect their own remote MCP servers
# (default true; an org can also switch them off), and external MCP requests per learner per minute (default 30)
WORKSHOP_AGENT_RUNS=
WORKSHOP_EXTERNAL_MCP=
WORKSHOP_EXTERNAL_PER_MIN=

# ── Organisation API and webhooks ───────────────────────────────────────
# Requests per organisation API key on /api/v1/ (default 600/hour), and days the webhook delivery log is kept (default 30)
API_KEY_RATE=
WEBHOOK_RETENTION_DAYS=

# ── Email (console backend prints mails in dev) ─────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Aasan <no-reply@aasan.local>

# Error monitoring (https://sentry.io, or self-hosted GlitchTip). A public site refuses to start without it unless
# SENTRY_OPTIONAL=1 says you run without error reporting on purpose.
SENTRY_DSN=
SENTRY_OPTIONAL=
# Bearer token for /api/metrics/ (Prometheus; infra/docker-compose.monitoring.yml). Empty = endpoint off.
METRICS_TOKEN=
# Fraction of requests traced for performance (0..1, default 0)
SENTRY_TRACES=

# Reverse proxies in front of Django (nginx = 1, cloud load balancer + nginx = 2). 0 for local dev.
DJANGO_NUM_PROXIES=0

# ── Production hardening (only used when DJANGO_DEBUG is off) ───────────
# Redirect plain HTTP to HTTPS (default true; docker-compose turns it off for plain-HTTP localhost)
DJANGO_SECURE_SSL_REDIRECT=
# HSTS max-age in seconds (default 31536000, one year) and whether it covers subdomains
DJANGO_HSTS_SECONDS=
DJANGO_HSTS_SUBDOMAINS=
# Admin console changes need a sign-in within this many minutes (default 30); the console asks again. 0 = off.
ADMIN_REAUTH_MINUTES=
# Staff prove admin changes with a passkey or an emailed code, not a password alone (default true; the password
# still counts until email works, so nobody is locked out of setting up mail).
STAFF_SECOND_FACTOR=
# Refuse passwords found in public breaches (Have I Been Pwned, k-anonymity; fails open if unreachable). Default true.
PASSWORD_BREACH_CHECK=
# Readiness probe answers are reused this many seconds (default 5); nginx also rate-limits /api/health/.
HEALTH_CACHE_SECONDS=
# Migrations: give up after waiting this long (ms) for a table lock, instead of blocking live traffic (compose: 5000).
DB_LOCK_TIMEOUT_MS=
# Move the Django admin to a less guessable path (default api/django-admin/; keep the trailing slash, never empty)
# DJANGO_ADMIN_PATH=api/django-admin/
